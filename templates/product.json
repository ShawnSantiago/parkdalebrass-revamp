{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "eyebrow": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.type != blank -%}<p class=\"product__text caption-with-letter-spacing\">{{ product.type | escape }}</p>{%- endif -%}"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "short_description": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pb-product-detail', product: product, field: 'short_description' %}"
          }
        },
        "divider": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"pb-divider pb-divider--flex\" aria-hidden=\"true\"><span class=\"pb-diamond pb-diamond--sm\"></span></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle",
            "pb_size_start": true
          }
        },
        "size_guide": {
          "type": "popup",
          "settings": {
            "text": "Size guide",
            "page": "size-guide",
            "pb_size_legend": true
          }
        },
        "fit_note": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'pb-product-detail', product: product, field: 'fit_notes' %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "service": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "",
            "icon_2": "return",
            "heading_2": "",
            "icon_3": "none",
            "heading_3": ""
          }
        },
        "tab_description": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "icon": "none",
            "content": "",
            "pb_source": "description",
            "pb_open": true
          }
        },
        "tab_materials": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials & finish",
            "icon": "none",
            "content": "",
            "pb_source": "materials",
            "pb_open": false
          }
        },
        "tab_dimensions": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions & fit",
            "icon": "none",
            "content": "",
            "pb_source": "dimensions",
            "pb_open": false
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "none",
            "content": "",
            "pb_source": "care",
            "pb_open": false
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "none",
            "content": "",
            "pb_source": "content",
            "pb_open": false
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "price",
        "short_description",
        "divider",
        "variant_picker",
        "size_guide",
        "fit_note",
        "buy_buttons",
        "service",
        "tab_description",
        "tab_materials",
        "tab_dimensions",
        "tab_care",
        "tab_shipping"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "gallery_layout": "thumbnail",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "pb_archive": true,
        "pb_show_breadcrumbs": true,
        "pb_breadcrumb_menu": "shop-categories",
        "padding_top": 32,
        "padding_bottom": 0,
        "pb_padding_top_mobile": 16
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Wear it with",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 100,
        "padding_bottom": 100
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
