{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  {%- comment -%}
    PB: Archive-Home-Mobile spaces the footer 36 top and 40 bottom: half the top setting and the full bottom one,
    instead of Dawn's 0.75 scale.
  {%- endcomment -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | divided_by: 2 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- comment -%} /PB {%- endcomment -%}

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- comment -%} PB: link groups render their heading with the menu (D-22). {%- endcomment -%}
                {%- if block.settings.heading != blank and block.type != 'link_list' -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}
                {%- comment -%} /PB {%- endcomment -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- when 'link_list' -%}
                    {%- comment -%} PB: native disclosures on mobile and static desktop navigation (D-22). {%- endcomment -%}
                    {%- assign menu_heading = block.settings.heading | strip_html | default: block.settings.menu.title -%}
                    {%- capture footer_menu_links -%}
                      <ul class="footer-block__details-content list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a
                              href="{{ link.url | escape }}"
                              class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                            >
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endcapture -%}
                    {%- if block.settings.menu.links.size > 0 -%}
                      <div class="small-hide">
                        <h2 class="footer-block__heading">{{ menu_heading | escape }}</h2>
                        {{ footer_menu_links }}
                      </div>
                      <details class="pb-footer-acc medium-hide large-up-hide" id="Details-Footer-{{ block.id }}">
                        <summary>
                          <h2 class="footer-block__heading">{{ menu_heading | escape }}</h2>
                          <span class="pb-footer-acc__marker" aria-hidden="true"></span>
                        </summary>
                        {{ footer_menu_links }}
                      </details>
                    {%- elsif menu_heading != blank -%}
                      <h2 class="footer-block__heading">{{ menu_heading | escape }}</h2>
                    {%- endif -%}
                    {%- comment -%} /PB {%- endcomment -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- if settings.brand_image != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: settings.brand_image.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- else -%}
                        {%- comment -%} PB: Archive wordmark when no brand image is configured (D-14, D-19). {%- endcomment -%}
                        <a class="pb-footer-wordmark" href="{{ routes.root_url }}">
                          <span class="pb-diamond pb-diamond--sm" aria-hidden="true"></span>
                          {{- shop.name | escape -}}
                        </a>
                        {%- comment -%} /PB {%- endcomment -%}
                      {%- endif -%}
                      {%- comment -%} PB: present the brand headline and description as one muted line. {%- endcomment -%}
                      <div class="pb-footer-brand-copy">
                        {%- if settings.brand_headline != blank -%}
                          <span>{{ settings.brand_headline }}</span>
                        {%- endif -%}
                        {%- if settings.brand_description != blank -%}
                          <div class="rte">{{ settings.brand_description }}</div>
                        {%- endif -%}
                      </div>
                      {%- comment -%} /PB {%- endcomment -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div
          class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'footer__list-social' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- comment -%}
      PB: one bottom bar after a content-width hairline: the copyright, the policy links and the Country/region
      select (02 §2.8; Archive-Home, Archive-Home-Mobile). Shopify's "Powered by" link isn't in the design.
      The legal group is display: contents on desktop, so its two parts and the select share one row.
    {%- endcomment -%}
    <div class="footer__content-bottom-wrapper page-width">
      <div class="pb-footer-bar">
        <div class="pb-footer-bar__legal">
          <p class="pb-footer-bar__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
          {%- if section.settings.show_policy -%}
            <ul class="pb-footer-bar__policies list-unstyled" role="list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url | escape }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        <div class="footer__column footer__localization isolate">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div class="pb-footer-country">
                  <span class="pb-footer-country__label" id="FooterCountryLabel">
                    {{- 'localization.country_label' | t -}}
                  </span>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div class="pb-footer-country">
                  <span class="pb-footer-country__label" id="FooterLanguageLabel">
                    {{- 'localization.language_label' | t -}}
                  </span>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
        {%- comment -%} /PB {%- endcomment -%}
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
      {%- comment -%} PB: closes .pb-footer-bar {%- endcomment -%}
      </div>
      {%- comment -%} /PB {%- endcomment -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  /* PB: Archive footer, D-19 and D-22; 2.x QA spacing and bottom bar (02 §2.8, Archive-Home, Archive-Home-Mobile).
     Section stylesheets load before Dawn's section-footer.css and component-localization-form.css, so these
     selectors carry the extra classes they need to win. */
  footer.footer[class*="color-"] {
    border-top: 1px solid var(--pb-gold-line);
  }

  .footer .footer-block__heading {
    color: var(--pb-gold);
    font: 600 1.1rem / 1.5 var(--font-body-family);
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .pb-footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    color: var(--pb-ivory);
    font: 600 2.1rem / 1.6 var(--pb-serif);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .pb-footer-wordmark .pb-diamond {
    width: 0.9rem;
    height: 0.9rem;
  }

  .footer .footer-block__brand-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .pb-footer-brand-copy {
    max-width: 28rem;
    color: var(--pb-muted);
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .pb-footer-brand-copy > span {
    margin-inline-end: 0.25em;
  }

  .pb-footer-brand-copy .rte,
  .pb-footer-brand-copy .rte > p:only-child {
    display: inline;
    color: inherit;
  }

  .footer .footer-block__details-content .list-menu__item--link {
    color: var(--pb-ivory);
    font-size: 1.4rem;
  }

  .footer .footer-block__details-content .list-menu__item--link:hover {
    color: var(--pb-gold);
  }

  .footer .footer__content-top.page-width {
    padding-bottom: 0;
  }

  /* Bottom bar: a --pb-rule hairline at content width, then ©, the policies and Country/region on one row. */
  .footer .footer__content-bottom {
    padding-top: 0;
    border-top: 0;
  }

  .footer .footer__content-bottom .footer__content-bottom-wrapper {
    display: block;
  }

  .pb-footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    margin-top: 5.6rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--pb-rule);
    color: var(--pb-muted);
    font-size: 1.3rem;
    line-height: 1.5;
    letter-spacing: normal;
  }

  .pb-footer-bar__legal {
    display: contents;
  }

  .pb-footer-bar__copy {
    margin: 0;
  }

  .pb-footer-bar__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    margin: 0;
    padding: 0;
  }

  .pb-footer-bar__policies a {
    color: var(--pb-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .pb-footer-bar__policies a:hover {
    color: var(--pb-gold);
  }

  .footer .pb-footer-bar .footer__column {
    width: auto;
    padding: 0;
  }

  .footer .pb-footer-bar .footer__column--info:not(:has(.list-payment__item)) {
    display: none;
  }

  .footer .pb-footer-bar .footer__localization {
    flex-wrap: nowrap;
    justify-content: flex-end;
    padding: 0;
  }

  .footer .pb-footer-bar .localization-form {
    display: block;
    width: auto;
    margin: 0;
    padding: 0;
  }

  .pb-footer-country {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pb-footer-country__label {
    color: var(--pb-muted);
    font-size: 1.3rem;
  }

  /* The select: onyx-raised, 1px rule-strong border, radius 2, 40 tall [44, full width]; no Dawn ring. */
  .footer .pb-footer-country .disclosure__button.localization-form__select {
    width: auto;
    height: 4rem;
    min-height: 4rem;
    margin: 0;
    padding: 0 2.8rem 0 1rem;
    border: 1px solid var(--pb-rule-strong);
    border-radius: 2px;
    background: var(--pb-onyx-raised);
    color: var(--pb-ivory);
    font: 400 1.3rem / 1.2 var(--font-body-family);
    letter-spacing: normal;
  }

  .footer .pb-footer-country .disclosure__button.localization-form__select::before,
  .footer .pb-footer-country .disclosure__button.localization-form__select::after {
    content: none;
  }

  .footer .pb-footer-country .localization-form__select .icon-caret {
    right: 1rem;
  }

  @media (min-width: 750px) {
    .footer .footer__content-top .footer__blocks-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
      gap: 4rem;
    }

    .footer .footer__content-top .footer__blocks-wrapper > .footer-block {
      width: auto;
      max-width: none;
    }

    .footer .footer-block--menu .footer-block__heading {
      margin-bottom: 1.6rem;
    }

    /* Archive-Home link rows: 14px at 1.6 with 10px between. */
    .footer .footer-block__details-content .list-menu__item--link {
      line-height: 1.6;
    }

    /* The country list opens above the select and lines up with its right edge. */
    .footer .pb-footer-country .disclosure__list-wrapper {
      right: 0;
      left: auto;
    }
  }

  @media (max-width: 749px) {
    footer.footer .footer__content-top.page-width {
      padding: 0 2rem;
    }

    .footer .footer__content-top .footer__blocks-wrapper {
      margin-bottom: 0;
    }

    .footer .footer__content-top .footer-block.grid__item {
      margin: 0;
    }

    .pb-footer-wordmark {
      gap: 1rem;
      font-size: 1.9rem;
      letter-spacing: 0.3em;
      white-space: nowrap;
    }

    .pb-footer-wordmark .pb-diamond {
      width: 0.8rem;
      height: 0.8rem;
    }

    .pb-footer-brand-copy {
      display: none;
    }

    /* Accordion rows: 52px including a --pb-rule bottom border; the first also has the top border. */
    .footer .footer__content-top .footer-block.grid__item.footer-block--menu {
      border-top: 0;
      border-bottom: 1px solid var(--pb-rule);
    }

    .footer .footer__content-top .footer-block.grid__item:not(.footer-block--menu) + .footer-block--menu {
      margin-top: 2.4rem;
      border-top: 1px solid var(--pb-rule);
    }

    .pb-footer-acc summary,
    .footer-block--menu > .footer-block__heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 5.1rem;
    }

    .pb-footer-acc .footer-block__heading,
    .footer-block--menu > .footer-block__heading {
      margin: 0;
    }

    .pb-footer-acc .footer-block__details-content {
      margin: 0 0 1.6rem;
    }

    .pb-footer-acc__marker {
      color: var(--pb-gold);
      font: 600 1.8rem / 1 var(--font-body-family);
    }

    .pb-footer-acc__marker::before {
      content: '+';
    }

    .pb-footer-acc[open] .pb-footer-acc__marker::before {
      content: '−';
    }

    /* Country/region first (label above a full-width 44px select), then one 12px line of © and policies. */
    .pb-footer-bar {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 2.4rem;
      margin-top: 2.4rem;
      padding-top: 0;
      border-top: 0;
    }

    .footer .pb-footer-bar .footer__localization {
      order: -1;
      display: block;
    }

    .pb-footer-country {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }

    .footer .pb-footer-country .disclosure__button.localization-form__select {
      width: 100%;
      height: 4.4rem;
      min-height: 4.4rem;
    }

    /* Each part carries the separator after it, so no line starts with a "·". 24px lines keep the links
       24px targets (WCAG 2.5.8). */
    .pb-footer-bar__legal {
      display: block;
      font-size: 1.2rem;
      line-height: 2;
    }

    .pb-footer-bar__copy,
    .pb-footer-bar__policies li {
      display: inline-block;
      margin-inline-end: 0.6rem;
      white-space: nowrap;
    }

    .pb-footer-bar__policies {
      display: inline;
    }

    .pb-footer-bar__policies a {
      display: inline-block;
    }

    .pb-footer-bar__copy:not(:last-child)::after,
    .pb-footer-bar__policies li:not(:last-child)::after {
      content: '\00B7';
      content: '\00B7' / '';
      margin-inline-start: 0.6rem;
    }
  }
  /* /PB */
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
