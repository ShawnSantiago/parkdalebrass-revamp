{%- comment -%}
  PB · Featured (03 §4.3, 02 §2.2, §4.3). One section for both homepage states, so launch is one setting (D-06):
  - concepts: editorial concept cards from blocks. A "Concept" badge, no price element, no product link,
    no Product JSON-LD and no add to cart (D-05). A block link is optional and never a product URL.
  - collection: real products from a collection as 02 §2.2 product cards, then "View all jewelry".
    Renders nothing at all when the collection is unset or has no published products.
    Each card is one link: the 4:5 image (second image on hover), the name and gold price on one row, then the
    descriptor from custom.finish, or custom.short_description when there's no finish (04 §2), hidden when both
    are empty. The sold-out badge uses the concept badge shape in muted. No sale badge and no rating (D-13).
    Dawn's card-product has no descriptor line, so the card is rendered here with the same data and treatment as
    the collection track's snippets/pb-product-card.liquid.
  4-up from 960px, 2-up below (02 §1.3). A partial last row, for any count, keeps the full-row card width and
  centres at every width (D-35); section-pb-featured.css does it with selectors, so the markup carries no count.
{%- endcomment -%}
{%- liquid
  assign pb_s = section.settings
  assign pb_concepts = false
  if pb_s.mode != 'collection'
    assign pb_concepts = true
  endif

  assign pb_count = 0
  if pb_concepts
    for block in section.blocks
      if block.settings.name != blank or block.settings.image != blank
        assign pb_count = pb_count | plus: 1
      endif
    endfor
  elsif pb_s.collection != blank and pb_s.collection.products_count > 0
    assign pb_count = pb_s.collection.products_count | at_most: pb_s.products_to_show
  endif

  assign pb_badge = pb_s.badge_label
  if pb_badge == blank
    assign pb_badge = 'pb.badge.concept' | t
  endif
-%}

{%- if pb_count > 0 -%}
  {{ 'section-pb-head.css' | asset_url | stylesheet_tag }}
  {{ 'section-pb-featured.css' | asset_url | stylesheet_tag }}
  {%- unless pb_concepts -%}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}
  {% render 'pb-section-padding', section: section %}

  <section
    id="PbFeatured-{{ section.id }}"
    class="pb-featured pb-featured--{% if pb_concepts %}concepts{% else %}collection{% endif %} color-{{ pb_s.color_scheme }} gradient section-{{ section.id }}-padding"
    {% if pb_s.heading != blank %}
      aria-labelledby="PbFeatured-{{ section.id }}-heading"
    {% endif %}
  >
    <div class="page-width">
      {%- if pb_s.eyebrow != blank or pb_s.heading != blank or pb_concepts and pb_s.note != blank -%}
        <div class="pb-head pb-head--center">
          {%- if pb_s.eyebrow != blank -%}
            <p class="pb-eyebrow pb-eyebrow--ruled">{{ pb_s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if pb_s.heading != blank -%}
            <h2 id="PbFeatured-{{ section.id }}-heading" class="pb-head__heading">{{ pb_s.heading | escape }}</h2>
          {%- endif -%}
          {%- if pb_concepts and pb_s.note != blank -%}
            <p class="pb-head__note">{{ pb_s.note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Only .pb-featured__item children: the CSS finds a partial last row with :nth-child and centres it (D-35).
      {%- endcomment -%}
      <ul class="pb-featured__grid" role="list">
        {%- if pb_concepts -%}
          {%- for block in section.blocks -%}
            {%- assign pb_b = block.settings -%}
            {%- if pb_b.name == blank and pb_b.image == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign pb_link = ''
              if pb_b.link != blank
                unless pb_b.link contains '/products/'
                  assign pb_link = pb_b.link
                endunless
              endif
            -%}
            <li class="pb-featured__item" {{ block.shopify_attributes }}>
              <article
                class="pb-concept{% if pb_link != blank %} pb-concept--link{% endif %}"
                {% if pb_b.name != blank %}
                  aria-labelledby="PbConcept-{{ block.id }}"
                {% endif %}
              >
                <div class="pb-concept__media">
                  {%- if pb_b.image != blank -%}
                    {{
                      pb_b.image
                      | image_url: width: 1066
                      | image_tag:
                        class: 'pb-concept__img',
                        widths: '165, 360, 533, 720, 940, 1066',
                        sizes: '(min-width: 1440px) 311px, (min-width: 960px) 22vw, 46vw',
                        loading: 'lazy',
                        alt: pb_b.image.alt
                    }}
                  {%- else -%}
                    <span class="pb-placeholder pb-concept__placeholder" aria-hidden="true">
                      {{- 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
                    </span>
                  {%- endif -%}
                </div>
                {%- if pb_b.name != blank -%}
                  <h3 id="PbConcept-{{ block.id }}" class="pb-product-name pb-concept__name">
                    {%- if pb_link != blank -%}
                      <a href="{{ pb_link }}" class="pb-concept__link">{{ pb_b.name | escape }}</a>
                    {%- else -%}
                      {{- pb_b.name | escape -}}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                <span class="badge pb-concept__badge">{{ pb_badge | escape }}</span>
                {%- if pb_b.descriptor != blank -%}
                  <p class="pb-concept__descriptor">{{ pb_b.descriptor | escape }}</p>
                {%- endif -%}
              </article>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for product in pb_s.collection.products limit: pb_s.products_to_show -%}
            {%- liquid
              assign pb_media = product.featured_media
              assign pb_second = null
              if product.media[1] != null
                assign pb_second = product.media[1]
              endif

              assign pb_desc = product.metafields.custom.finish.value | strip
              if pb_desc == blank
                assign pb_desc = product.metafields.custom.short_description.value | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip
              endif
            -%}
            <li class="pb-featured__item">
              <product-component
                class="pb-pcard-wrapper"
                view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}"
              >
                <a class="pb-pcard" href="{{ product.url }}">
                  <div class="pb-pcard__media{% if pb_second %} pb-pcard__media--swap{% endif %}">
                    {%- if pb_media -%}
                      {{
                        pb_media
                        | image_url: width: 1066
                        | image_tag:
                          class: 'pb-pcard__img',
                          widths: '165, 360, 533, 720, 940, 1066',
                          sizes: '(min-width: 1440px) 311px, (min-width: 960px) 22vw, 46vw',
                          loading: 'lazy',
                          alt: ''
                      }}
                      {%- if pb_second -%}
                        {{
                          pb_second
                          | image_url: width: 1066
                          | image_tag:
                            class: 'pb-pcard__img pb-pcard__img--second',
                            widths: '165, 360, 533, 720, 940, 1066',
                            sizes: '(min-width: 1440px) 311px, (min-width: 960px) 22vw, 46vw',
                            loading: 'lazy',
                            alt: ''
                        }}
                      {%- endif -%}
                    {%- else -%}
                      <span class="pb-placeholder pb-pcard__placeholder" aria-hidden="true">
                        {{- 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="pb-pcard__row">
                    <h3 class="pb-product-name pb-pcard__name">{{ product.title | escape }}</h3>
                    <div class="pb-pcard__price">
                      {%- render 'price', product: product, price_class: '', show_compare_at_price: true -%}
                    </div>
                  </div>
                  {%- if pb_desc != blank -%}
                    <p class="pb-pcard__desc">{{ pb_desc | escape }}</p>
                  {%- endif -%}
                  {%- comment -%} After the name and price in the DOM, so it's read last; it sits on the image. {%- endcomment -%}
                  {%- if product.available == false -%}
                    <span class="badge pb-pcard__badge pb-pcard__badge--muted">{{ 'products.product.sold_out' | t }}</span>
                  {%- endif -%}
                </a>
              </product-component>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if pb_concepts == false and pb_s.view_all_label != blank -%}
        <div class="pb-featured__more">
          <a class="button button--secondary pb-featured__more-button" href="{{ pb_s.collection.url }}">
            {{- pb_s.view_all_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  {{ 'section-pb-head.css' | asset_url | stylesheet_tag }}
  <div class="page-width">
    <p class="pb-editor-note">
      {%- if pb_concepts -%}
        {{ 'pb.home.editor.featured_concepts_empty' | t }}
      {%- else -%}
        {{ 'pb.home.editor.featured_collection_empty' | t }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.pb_featured.name",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "t:sections.pb_featured.settings.mode.label",
      "info": "t:sections.pb_featured.settings.mode.info",
      "options": [
        {
          "value": "concepts",
          "label": "t:sections.pb_featured.settings.mode.options__1.label"
        },
        {
          "value": "collection",
          "label": "t:sections.pb_featured.settings.mode.options__2.label"
        }
      ],
      "default": "concepts"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.pb_featured.settings.collection.label",
      "info": "t:sections.pb_featured.settings.collection.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.pb_featured.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.pb_featured.settings.view_all_label.label",
      "info": "t:sections.pb_featured.settings.view_all_label.info",
      "default": "View all jewelry"
    },
    {
      "type": "header",
      "content": "t:pb.home.settings.content_header.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:pb.home.settings.eyebrow.label",
      "info": "t:sections.pb_featured.settings.eyebrow.info",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:pb.home.settings.heading.label",
      "default": "The first collection"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.pb_featured.settings.note.label",
      "info": "t:sections.pb_featured.settings.note.info",
      "default": "Concepts in development. Designs, finishes and prices may change before release."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:sections.pb_featured.settings.badge_label.label",
      "info": "t:sections.pb_featured.settings.badge_label.info",
      "default": "Concept"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "t:pb.home.settings.padding_top_mobile.label",
      "info": "t:pb.home.settings.padding_mobile.info"
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "t:pb.home.settings.padding_bottom_mobile.label",
      "info": "t:pb.home.settings.padding_mobile.info"
    }
  ],
  "blocks": [
    {
      "type": "concept",
      "name": "t:sections.pb_featured.blocks.concept.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.pb_featured.blocks.concept.settings.paragraph.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:pb.home.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.pb_featured.blocks.concept.settings.name.label"
        },
        {
          "type": "text",
          "id": "descriptor",
          "label": "t:sections.pb_featured.blocks.concept.settings.descriptor.label",
          "info": "t:sections.pb_featured.blocks.concept.settings.descriptor.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.pb_featured.blocks.concept.settings.link.label",
          "info": "t:sections.pb_featured.blocks.concept.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pb_featured.presets.name",
      "blocks": [
        {
          "type": "concept"
        },
        {
          "type": "concept"
        }
      ]
    }
  ]
}
{% endschema %}
