{%- comment -%}
  Visible breadcrumb trail plus BreadcrumbList JSON-LD (02 §5, 03 §10).
  Styles: the PB2:foundation block in assets/pb-theme.css.

  Trails:
  - product page: Home > collection (if any) > product
  - collection page: Home > collection
  - anything else: Home > title (only when a title is passed)

  Accepts (all optional):
  - product: {Object} Defaults to the product template's product.
  - collection: {Object} Defaults to the template's collection. On a product page that is only set when the
    URL goes through a collection. Pass one explicitly to show a parent collection.
  - title: {String} Current-page label when there's no product or collection.
  - url: {String} Current-page URL for the JSON-LD with `title`. Defaults to request.path.
  - schema: {Boolean} Pass false to leave out the JSON-LD (e.g. when the trail is rendered twice).
  - class: {String} Extra classes on the nav.

  On screens under 750px a three-level trail drops "Home", as in the Archive-Product-Mobile artboard.
  The JSON-LD always keeps it.

  Usage:
  {% render 'pb-breadcrumbs' %}
  {% render 'pb-breadcrumbs', product: product, collection: collection %}
{%- endcomment -%}
{%- liquid
  assign pb_bc_product = product
  assign pb_bc_collection = collection
  assign pb_bc_title = title | strip
  assign pb_bc_url = url | default: request.path

  assign pb_bc_depth = 1
  if pb_bc_collection != blank
    assign pb_bc_depth = pb_bc_depth | plus: 1
  endif
  if pb_bc_product != blank
    assign pb_bc_depth = pb_bc_depth | plus: 1
  elsif pb_bc_collection == blank and pb_bc_title != blank
    assign pb_bc_depth = 2
  endif

  assign pb_bc_home_label = 'pb.breadcrumbs.home' | t
  assign pb_bc_origin = request.origin
-%}
{%- if pb_bc_depth > 1 -%}
  <nav
    class="pb-breadcrumbs{% if pb_bc_depth > 2 %} pb-breadcrumbs--long{% endif %}{% if class != blank %} {{ class | escape }}{% endif %}"
    aria-label="{{ 'pb.breadcrumbs.label' | t }}"
  >
    <ol class="pb-breadcrumbs__list" role="list">
      <li class="pb-breadcrumbs__item pb-breadcrumbs__item--home">
        <a class="pb-breadcrumbs__link" href="{{ routes.root_url }}">{{ pb_bc_home_label }}</a>
      </li>
      {%- if pb_bc_collection != blank -%}
        <li class="pb-breadcrumbs__sep" aria-hidden="true">/</li>
        {%- if pb_bc_product != blank -%}
          <li class="pb-breadcrumbs__item">
            <a class="pb-breadcrumbs__link" href="{{ pb_bc_collection.url }}">
              {{- pb_bc_collection.title | escape -}}
            </a>
          </li>
        {%- else -%}
          <li class="pb-breadcrumbs__item" aria-current="page">{{ pb_bc_collection.title | escape }}</li>
        {%- endif -%}
      {%- endif -%}
      {%- if pb_bc_product != blank -%}
        <li class="pb-breadcrumbs__sep" aria-hidden="true">/</li>
        <li class="pb-breadcrumbs__item" aria-current="page">{{ pb_bc_product.title | escape }}</li>
      {%- elsif pb_bc_collection == blank -%}
        <li class="pb-breadcrumbs__sep" aria-hidden="true">/</li>
        <li class="pb-breadcrumbs__item" aria-current="page">{{ pb_bc_title | escape }}</li>
      {%- endif -%}
    </ol>
  </nav>

  {%- unless schema == false -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ pb_bc_home_label | json }},
            "item": {{ pb_bc_origin | append: routes.root_url | json }}
          }
          {%- if pb_bc_collection != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ pb_bc_collection.title | json }},
              "item": {{ pb_bc_origin | append: pb_bc_collection.url | json }}
            }
          {%- endif -%}
          {%- if pb_bc_product != blank -%}
            ,
            {
              "@type": "ListItem",
              "position": {{ pb_bc_depth }},
              "name": {{ pb_bc_product.title | json }},
              "item": {{ pb_bc_origin | append: pb_bc_product.url | json }}
            }
          {%- elsif pb_bc_collection == blank -%}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ pb_bc_title | json }},
              "item": {{ pb_bc_origin | append: pb_bc_url | json }}
            }
          {%- endif -%}
        ]
      }
    </script>
  {%- endunless -%}
{%- endif -%}
