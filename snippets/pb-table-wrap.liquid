{%- comment -%}
  Wraps each <table> in merchant HTML in a labelled region that scrolls sideways when the table
  is wider than the reading column (pb-page body and HTML blocks). The region is focusable, so a
  keyboard user can scroll it (there's no JavaScript to tell which tables overflow).
  The region is named after the table's <caption>, or else the last h2–h4 heading before the table,
  or else "Table 1", "Table 2", ... in page order. With a label, that last name reads "Description: Table 1",
  so tables in different product tabs get different names.

  Accepts:
  - html: {String} merchant HTML (page.content, an html setting, or a product tab's content)
  - offset: {Number} tables already numbered earlier on the page (default 0)
  - label: {String} optional prefix for the numbered name, such as the product tab's heading

  Usage:
  {% render 'pb-table-wrap', html: page.content, offset: 0 %}
{%- endcomment -%}
{%- liquid
  assign pb_offset = offset | default: 0
  assign pb_parts = html | split: '<table'
  for pb_part in pb_parts
    assign pb_part_closed = pb_part | replace: '</table>', '</table></div>'
    if forloop.first
      echo pb_part_closed
    else
      assign pb_index = pb_offset | plus: forloop.index0
      assign pb_name = ''

      assign pb_table = pb_part | split: '</table>' | first
      if pb_table contains '<caption'
        assign pb_caption = pb_table | split: '<caption'
        assign pb_name = pb_caption[1] | split: '</caption>' | first
        assign pb_name = '<caption' | append: pb_name | strip_html | strip
      endif

      if pb_name == blank
        assign pb_prev_index = forloop.index0 | minus: 1
        assign pb_prev = pb_parts[pb_prev_index] | append: ' ' | split: '</table>' | last
        assign pb_prev = pb_prev | replace: '<h2', '<pb-h' | replace: '<h3', '<pb-h' | replace: '<h4', '<pb-h'
        if pb_prev contains '<pb-h'
          assign pb_name = pb_prev | split: '<pb-h' | last | split: '</h' | first
          assign pb_name = '<h' | append: pb_name | strip_html | strip
        endif
      endif

      if pb_name == blank
        assign pb_name = 'pb.page.table_label' | t: index: pb_index
        if label != blank
          assign pb_name = label | append: ': ' | append: pb_name
        endif
      endif
      assign pb_name = pb_name | truncate: 80 | escape_once

      echo '<div class="pb-page__table" role="region" tabindex="0" aria-label="' | append: pb_name | append: '"><table' | append: pb_part_closed
    endif
  endfor
-%}
