{%- comment -%}
  A main-product collapsible tab in the Archive spec (02 §2.6, D-23). This is Dawn's collapsible_tab markup,
  moved out of sections/main-product.liquid with three additions:
  - "Content from" (pb_source) can fill the tab from a product field: product.description, or the custom.*
    metafields via snippets/pb-product-detail.liquid. The block's own content and page follow it.
  - An empty tab is hidden on the storefront. The theme editor shows it with a bracketed note.
  - "Open by default" (pb_open) renders the details element open.

  Accepts:
  - block: {Object} The collapsible_tab block (required)
  - product: {Object} Product (required)
  - section_id: {String} main-product section ID (required)

  Usage:
  {% render 'pb-product-tab', block: block, product: product, section_id: section.id %}
{%- endcomment -%}
{%- capture pb_tab_content -%}
  {%- case block.settings.pb_source -%}
    {%- when 'description' -%}
      {{ product.description }}
    {%- when 'materials', 'dimensions', 'care' -%}
      {%- render 'pb-product-detail', product: product, field: block.settings.pb_source -%}
  {%- endcase -%}
  {{ block.settings.content }}
  {{ block.settings.page.content }}
{%- endcapture -%}
{%- assign pb_tab_content = pb_tab_content | strip -%}
{%- if pb_tab_content != blank or request.design_mode -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section_id }}"{% if block.settings.pb_open %} open{% endif %}>
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: block.settings.icon %}
          <h2 class="h4 accordion__title inline-richtext">
            {{ block.settings.heading | default: block.settings.page.title | escape }}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section_id }}">
        {%- if pb_tab_content != blank -%}
          {{ pb_tab_content }}
        {%- else -%}
          <p class="pb-editor-note">{{ 'pb.product.editor_empty_tab' | t }}</p>
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}
