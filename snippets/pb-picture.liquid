{%- comment -%}
  Renders a <picture> for a pb-* section: the main image, plus an optional separate crop for narrow screens
  (02 §3: hero and editorial have their own mobile crops). The caller sizes and positions the <img> with CSS.

  Accepts:
  - image: {Object} The main image (required)
  - image_mobile: {Object} Optional crop used up to mobile_max
  - mobile_max: {Number} Widest viewport, in px, that uses image_mobile. Default 749.
  - sizes: {String} sizes for the main image
  - mobile_sizes: {String} sizes for the mobile crop. Default 100vw.
  - class: {String} Class on the <img>
  - eager: {Boolean} Load eagerly with fetchpriority high (the hero, the page's LCP image). Default false: lazy.
  - alt: {String} Optional alt text. Default: the image's own alt text.

  Usage:
  {% render 'pb-picture', image: section.settings.image, image_mobile: section.settings.image_mobile, sizes: '100vw', class: 'x' %}
{%- endcomment -%}
{%- liquid
  assign pb_pic_mq = mobile_max | default: 749
  assign pb_pic_alt = alt | default: image.alt | default: ''
  assign pb_pic_widths = '375,550,750,1100,1500,1800,2200' | split: ','
-%}
<picture>
  {%- if image_mobile != blank -%}
    {%- liquid
      assign pb_pic_srcset = ''
      for pb_pic_w in pb_pic_widths
        assign pb_pic_w_px = pb_pic_w | plus: 0
        if image_mobile.width > pb_pic_w_px
          assign pb_pic_src = image_mobile | image_url: width: pb_pic_w_px
          assign pb_pic_srcset = pb_pic_srcset | append: pb_pic_src | append: ' ' | append: pb_pic_w | append: 'w, '
        endif
      endfor
      assign pb_pic_src = image_mobile | image_url
      assign pb_pic_srcset = pb_pic_srcset | append: pb_pic_src | append: ' ' | append: image_mobile.width | append: 'w'
    -%}
    <source
      media="(max-width: {{ pb_pic_mq }}px)"
      srcset="{{ pb_pic_srcset }}"
      sizes="{{ mobile_sizes | default: '100vw' }}"
      width="{{ image_mobile.width }}"
      height="{{ image_mobile.height }}"
    >
  {%- endif -%}
  {%- if eager -%}
    {{
      image
      | image_url: width: 2200
      | image_tag:
        class: class,
        widths: '375, 550, 750, 1100, 1500, 1800, 2200',
        sizes: sizes,
        loading: 'eager',
        fetchpriority: 'high',
        alt: pb_pic_alt
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 2200
      | image_tag:
        class: class,
        widths: '375, 550, 750, 1100, 1500, 1800, 2200',
        sizes: sizes,
        loading: 'lazy',
        alt: pb_pic_alt
    }}
  {%- endif -%}
</picture>
